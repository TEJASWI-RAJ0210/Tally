# Neon pooled connection string for the app at runtime (hostname contains -pooler).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection string for Prisma migrations (remove -pooler from hostname).
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Long random strings - generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
